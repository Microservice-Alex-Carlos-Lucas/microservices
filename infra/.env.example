# Copie para infra/.env (gitignored) e preencha com suas credenciais.
# Nunca commitar .env nem AWS keys.

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# RDS
DB_INSTANCE_ID=store-db
DB_NAME=store
DB_USERNAME=store
DB_PASSWORD=change-me-strong
DB_INSTANCE_CLASS=db.t3.micro
ALLOCATED_STORAGE=20

# Cluster
EKS_CLUSTER_NAME=store-cluster
